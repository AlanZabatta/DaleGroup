<div style="padding: 24px 18px 40px; font-family: Poppins, sans-serif; max-width: 600px; margin: 0 auto; background-color: white; min-height: 100vh;">
  <a href="/mi-tienda" style="display: inline-flex; background: none; border: none; color: #186904; font-size: 22px; font-weight: 700; cursor: pointer; line-height: 1; text-decoration: none; margin-bottom: 16px;">&#x2715;</a>
  <p style="font-size: 26px; font-weight: 800; color: #186904; margin: 0 0 20px;">Horarios</p>

  <a href="/mi-tienda/horarios/nuevo" style="display: block; text-align: center; background-color: #186904; color: white; padding: 14px; border-radius: 16px; text-decoration: none; margin-bottom: 24px; font-family: Poppins, sans-serif; font-weight: 700; font-size: 14px;">
    + Crear horario
  </a>

  <%= if Enum.empty?(@horarios) do %>
    <p style="color: #999; font-family: Poppins, sans-serif; font-size: 14px; text-align: center; padding: 40px 0;">Todavía no creaste ningún horario.</p>
  <% else %>
    <%= for horario <- @horarios do %>
      <%
        cantidad_empleados = Enum.count(@cajeros, fn c -> c.horario_id == horario.id end)
        dias_texto = Enum.join(horario.dias, ", ")
        horario_texto = if horario.tipo == "general" do
          "#{horario.hora_entrada_general} a #{horario.hora_salida_general}"
        else
          "Horario específico por día"
        end
      %>
      <div style="background: white; border: 1px solid #f2f2f2; border-radius: 18px; padding: 16px 18px; margin-bottom: 12px; box-shadow: 0 3px 12px rgba(0,0,0,0.05);">
        <p style="font-size: 15px; font-weight: 700; color: #111; margin: 0 0 4px; font-family: Poppins, sans-serif;">
          <%= if horario.nombre && horario.nombre != "", do: horario.nombre, else: "Horario sin nombre" %>
        </p>
        <p style="font-size: 12px; color: #888; margin: 0 0 2px; font-family: Poppins, sans-serif;"><%= dias_texto %></p>
        <p style="font-size: 12px; color: #888; margin: 0 0 6px; font-family: Poppins, sans-serif;"><%= horario_texto %></p>
        <p style="font-size: 11px; color: #186904; margin: 0; font-family: Poppins, sans-serif; font-weight: 600;"><%= cantidad_empleados %> empleado<%= if cantidad_empleados != 1, do: "s" %> asignado<%= if cantidad_empleados != 1, do: "s" %></p>
      </div>
    <% end %>
  <% end %>
</div>
