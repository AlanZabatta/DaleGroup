<div style="padding: 24px 18px 40px; font-family: Poppins, sans-serif; max-width: 600px; margin: 0 auto; background-color: white; min-height: 100vh;">
  <a href="/mi-tienda" style="display: inline-flex; background: none; border: none; color: #186904; font-size: 22px; font-weight: 700; cursor: pointer; line-height: 1; text-decoration: none; margin-bottom: 16px;">&#x2715;</a>
  <p style="font-size: 26px; font-weight: 800; color: #186904; margin: 0 0 4px;">Cupón de tu marca</p>
  <p style="font-size: 12.5px; color: #999; margin: 0 0 24px; font-family: Poppins, sans-serif; line-height: 1.4;">Un descuento único que se aplica a toda tu tienda dentro de Dale.</p>

  <%= if @flash[:error] do %>
    <div style="background: #fff3f2; border: 1.5px solid #c0392b; border-radius: 14px; padding: 12px 14px; margin-bottom: 20px;">
      <p style="font-size: 12.5px; color: #c0392b; margin: 0; font-family: Poppins, sans-serif; line-height: 1.4;"><%= @flash[:error] %></p>
    </div>
  <% end %>

  <%= if @flash[:info] do %>
    <div style="background: #eef9f0; border: 1.5px solid #186904; border-radius: 14px; padding: 12px 14px; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#186904" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><polyline points="20 6 9 17 4 12"/></svg>
      <p style="font-size: 12.5px; color: #186904; margin: 0; font-family: Poppins, sans-serif; font-weight: 600;"><%= @flash[:info] %></p>
    </div>
  <% end %>

  <%= if @cupon do %>
    <div style="position: relative; margin-bottom: 32px;">
      <div style="background: linear-gradient(135deg, #186904 0%, #0f4a02 100%); border-radius: 26px; padding: 30px 24px 26px; text-align: center; box-shadow: 0 10px 30px rgba(24,105,4,0.30); position: relative; overflow: hidden;">
        <div style="position: absolute; top: -30px; right: -30px; width: 110px; height: 110px; border-radius: 50%; background: rgba(255,255,255,0.06);"></div>
        <div style="position: absolute; bottom: -40px; left: -20px; width: 130px; height: 130px; border-radius: 50%; background: rgba(255,255,255,0.05);"></div>

        <div style="display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.15); border-radius: 20px; padding: 5px 14px; margin-bottom: 14px; position: relative;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 12 21.99 2 12V2h10l10 10a2 2 0 0 1 0 2.83zM7 7h.01"/></svg>
          <span style="font-size: 11px; font-weight: 700; color: white; text-transform: uppercase; letter-spacing: 1px;">Cupón activo</span>
        </div>

        <p style="font-size: 64px; font-weight: 800; color: white; margin: 0; line-height: 1; position: relative; text-shadow: 0 3px 12px rgba(0,0,0,0.15);"><%= @cupon.discount %>%</p>
        <p style="font-size: 13px; color: rgba(255,255,255,0.85); margin: 10px 0 0; font-family: Poppins, sans-serif; position: relative;">de descuento para tus clientes</p>
      </div>

      <div style="position: absolute; top: 50%; left: -10px; width: 20px; height: 20px; border-radius: 50%; background: white; transform: translateY(-50%);"></div>
      <div style="position: absolute; top: 50%; right: -10px; width: 20px; height: 20px; border-radius: 50%; background: white; transform: translateY(-50%);"></div>
      <div style="position: absolute; top: 50%; left: 18px; right: 18px; border-top: 2px dashed rgba(255,255,255,0.35); transform: translateY(-50%);"></div>
    </div>
  <% end %>

  <form action={~p"/mi-tienda/cupon"} method="post">
    <input type="hidden" name="_csrf_token" value={get_csrf_token()}/>

    <p style="font-size: 12px; font-weight: 700; color: #186904; margin: 0 0 10px; text-transform: uppercase; letter-spacing: 1px;">Elegí el descuento</p>

    <div style="display: flex; align-items: center; justify-content: center; gap: 18px; background: #f7f5ef; border-radius: 24px; padding: 20px; margin-bottom: 6px;">
      <button type="button" onclick="cambiarDescuento(-1)" style="width: 46px; height: 46px; border-radius: 50%; border: none; background: white; box-shadow: 0 2px 8px rgba(0,0,0,0.08); cursor: pointer; font-size: 22px; font-weight: 700; color: #186904; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">−</button>
      <div style="text-align: center; min-width: 90px;">
        <input type="number" id="input-descuento" name="coupon[discount]" min="10" max="100" value={if @cupon, do: @cupon.discount, else: "10"} readonly style="width: 90px; text-align: center; font-size: 42px; font-weight: 800; color: #186904; border: none; background: none; outline: none; font-family: Poppins, sans-serif;"/>
        <p style="font-size: 11px; color: #999; margin: -4px 0 0; font-family: Poppins, sans-serif;">por ciento</p>
      </div>
      <button type="button" onclick="cambiarDescuento(1)" style="width: 46px; height: 46px; border-radius: 50%; border: none; background: #186904; box-shadow: 0 2px 8px rgba(24,105,4,0.25); cursor: pointer; font-size: 22px; font-weight: 700; color: white; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">+</button>
    </div>
    <p style="font-size: 11px; color: #bbb; text-align: center; margin: 0 0 28px; font-family: Poppins, sans-serif;">Mínimo 10%</p>

    <button type="submit" style="width: 100%; background-color: #186904; color: white; padding: 15px 0; border: none; border-radius: 16px; cursor: pointer; font-size: 15px; font-weight: 700; font-family: Poppins, sans-serif; box-shadow: 0 6px 18px rgba(24,105,4,0.25); margin-bottom: 28px;">
      <%= if @cupon, do: "Actualizar Cupón", else: "Crear Cupón" %>
    </button>

    <div style="display: flex; gap: 10px; align-items: flex-start; background: #f7f5ef; border-radius: 16px; padding: 14px 16px; margin-bottom: 12px;">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#186904" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 1px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
      <p style="font-size: 12px; color: #666; margin: 0; font-family: Poppins, sans-serif; line-height: 1.5;">
        Se aplica a <b>todos los productos</b> de tu tienda dentro de Dale. <b>No es acumulable</b> con otras ofertas.
      </p>
    </div>

    <div style="display: flex; gap: 10px; align-items: flex-start; background: #fff3f2; border: 1.5px solid #f0c4c0; border-radius: 16px; padding: 14px 16px;">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#a8392f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 1px;"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <p style="font-size: 12px; color: #a8392f; margin: 0; font-family: Poppins, sans-serif; line-height: 1.5;">
        <b>No está permitido</b> inflar el precio de tus productos para simular un descuento inexistente. Es ilegal (Ley 24.240) y Dale también penaliza a las marcas que detecte haciendo esto.
      </p>
    </div>
  </form>
</div>

<script>
  function cambiarDescuento(delta) {
    const input = document.getElementById('input-descuento');
    let valor = parseInt(input.value || '10', 10) + delta;
    if (valor < 10) valor = 10;
    if (valor > 100) valor = 100;
    input.value = valor;
  }
</script>
